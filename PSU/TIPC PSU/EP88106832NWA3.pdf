                  <patent:NumberOfPages>1</patent:NumberOfPages>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <patent:DocumentSection>abstract</patent:DocumentSection>
                  <patent:StartPage>1</patent:StartPage>
                  <patent:NumberOfPages>1</patent:NumberOfPages>
               </rdf:li>
            </rdf:Seq>
         </patent:DocumentStructure>
